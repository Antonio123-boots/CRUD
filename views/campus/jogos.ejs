<section class="panel-card">
  <h1>Jogos do campus</h1>
  <p class="panel-subtitle">Acompanhe aqui todos os jogos relacionados à sua instituição.</p>

  <article class="mini-card">
    <h2><%= nomeCampus %></h2>
    <% if (jogosCampus.length) { %>
      <div class="game-grid">
        <% jogosCampus.forEach((jogo) => { %>
          <article class="game-card">
            <p class="game-time"><%= jogo.data %> · <%= jogo.horario %></p>
            <h3><%= jogo.casa %> x <%= jogo.fora %></h3>
            <p class="game-result">Modalidade: <%= jogo.modalidade %></p>
            <p class="game-result">Placar: <%= jogo.placar %></p>
            <span class="status-pill"><%= jogo.status %></span>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="panel-subtitle">Nenhum jogo cadastrado para este campus no momento.</p>
    <% } %>
  </article>
</section>
