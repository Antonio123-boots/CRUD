<div class="profile-shell">
  
  <div class="profile-card--wide">
    
    <div class="institution-header">
      <div>
        <h1 style="color: #ece42d; margin-bottom: 0.5rem;">Configurações Gerais do Evento</h1>
        <p style="color: rgba(255, 255, 255, 0.7); font-size: 0.95rem;">
          Gerencie prazos, limites de delegações por campus e cadastro de modalidades oficiais do JIFC.
        </p>
      </div>
    </div>

    <form action="/admin/configurar/salvar" method="POST" style="margin-top: 2rem;">
      
      <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
        <h2 style="color: #ece42d; font-size: 1.2rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px;">
          📅 Período do JIFC
        </h2>
        <div class="form-grid">
          <label>
            <span>Data de Início do Evento</span>
            <input type="date" name="inicio_evento" value="<%= configuracoes.inicio_evento || '' %>" required>
          </label>
          <label>
            <span>Data de Término do Evento</span>
            <input type="date" name="fim_evento" value="<%= configuracoes.fim_evento || '' %>" required>
          </label>
        </div>
      </div>

      <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
        <h2 style="color: #ece42d; font-size: 1.2rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px;">
          ⏳ Prazos de Inscrições e Processos
        </h2>
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
          
          <label>
            <span>Abertura (Inscrição de Modalidades)</span>
            <input type="date" name="inicioInscricoesModalidades" value="<%= configuracoes.inicio_inscricao_modalidades || '' %>" required>
          </label>
          <label>
            <span>Fechamento (Inscrição de Modalidades)</span>
            <input type="date" name="fimInscricoesModalidades" value="<%= configuracoes.fim_inscricao_modalidades || '' %>" required>
          </label>

          <label>
            <span>Abertura (Inscrição de Atletas / Laudos)</span>
            <input type="date" name="inicioInscricoesAtletas" value="<%= configuracoes.inicio_inscricao_atletas || '' %>" required>
          </label>
          <label>
            <span>Fechamento (Inscrição de Atletas / Laudos)</span>
            <input type="date" name="fimInscricoesAtletas" value="<%= configuracoes.fim_inscricao_atletas || '' %>" required>
          </label>
          
          <label>
            <span>Início do Sorteio de Chaves</span>
            <input type="date" name="inicioSorteio" value="<%= configuracoes.inicio_sorteio_chaves || '' %>" required>
          </label>
          <label>
            <span>Fim do Sorteio de Chaves</span>
            <input type="date" name="fimSorteio" value="<%= configuracoes.fim_sorteio_chaves || '' %>" required>
          </label>
        </div>
      </div>

      <div style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
        <h2 style="color: #ece42d; font-size: 1.2rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px;">
          🛑 Limites de Inscrição por Campus
        </h2>
        <div class="form-grid">
          <label>
            <span>Máximo de Atletas por Modalidade</span>
            <input type="number" name="limite_atletas_por_modalidade" min="1" value="<%= configuracoes.limite_atletas_por_modalidade || 0 %>" placeholder="Ex: 12 para Futsal" required>
          </label>
          <label>
            <span>Quantidade Total Máxima da Delegação</span>
            <input type="number" name="limite_atletas_total_campus" min="1" value="<%= configuracoes.limite_atletas_total_campus || 0 %>" placeholder="Ex: 50 atletas no total" required>
          </label>
        </div>
      </div>

      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn-cta-jifc">Salvar Configurações Gerais</button>
      </div>
    </form>

    <div style="margin-top: 3.5rem;">
      <h2 style="color: #ece42d; font-size: 1.2rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px;">
        🏆 Cadastrar Nova Modalidade Esportiva
      </h2>
      <p style="color: rgba(255, 255, 255, 0.6); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Selecione uma das modalidades oficiais do JIFC ou escolha a opção "Outro..." para digitar manualmente.
      </p>

      <form action="/admin/modalidades/cadastrar" method="POST">
        <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: flex-end;">
          
          <label>
            <span>Selecione a Modalidade</span>
            <select name="modalidade_base" id="seletorModalidade" required style="width: 100%; padding: 0.75rem; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 0.95rem; outline: none;">
              <option value="" disabled selected>Escolha um esporte...</option>
              <option value="Atletismo">Atletismo</option>
              <option value="Basquetebol">Basquetebol</option>
              <option value="Futsal">Futsal</option>
              <option value="Handebol">Handebol</option>
              <option value="Tênis de Mesa">Tênis de Mesa</option>
              <option value="Voleibol">Voleibol</option>
              <option value="Vôlei de Praia">Vôlei de Praia</option>
              <option value="Xadrez">Xadrez</option>
              <option value="OUTRO">Outro...</option>
            </select>
          </label>

          <div id="containerModalidadeCustomizada" style="display: none;">
            <label style="display: flex; flex-direction: column; gap: 0.35rem;">
              <span style="color: #ece42d; font-weight: 600;">Nome da Nova Modalidade</span>
              <input type="text" name="modalidade_customizada" id="inputModalidadeCustomizada" placeholder="Digite o esporte customizado" style="width: 100%; padding: 0.75rem; background: rgba(0, 0, 0, 0.3); border: 1px solid #ece42d; border-radius: 8px; color: #fff; font-size: 0.95rem;">
            </label>
          </div>

          <label>
            <span>Gênero</span>
            <select name="genero" required style="width: 100%; padding: 0.75rem; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 0.95rem;">
              <option value="Masculino">Masculino</option>
              <option value="Feminino">Feminino</option>
              <option value="Misto">Misto</option>
            </select>
          </label>

          <label>
            <span>Tipo de Confronto</span>
            <select name="tipo_confronto" required style="width: 100%; padding: 0.75rem; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 0.95rem;">
              <option value="Coletivo">Coletivo</option>
              <option value="Individual">Individual</option>
            </select>
          </label>

          <div>
            <button type="submit" class="btn-cta-jifc" style="padding: 0.75rem; font-size: 0.95rem;">+ Adicionar</button>
          </div>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
  // Monitora o carregamento do documento para garantir estabilidade na árvore DOM
  document.addEventListener('DOMContentLoaded', function() {
    
    // Captura os elementos do seletor, do contêiner customizado e da caixa de texto livre
    const seletorModalidade = document.getElementById('seletorModalidade');
    const containerCustomizado = document.getElementById('containerModalidadeCustomizada');
    const inputCustomizado = document.getElementById('inputModalidadeCustomizada');

    // Escuta qualquer mudança de estado/clique no dropdown de esportes
    seletorModalidade.addEventListener('change', function() {
      
      // Se a opção selecionada for estritamente igual a "OUTRO"
      if (seletorModalidade.value === 'OUTRO') {
        containerCustomizado.style.display = 'block'; // Torna visível o campo de texto na tela
        inputCustomizado.setAttribute('required', 'true'); // Torna o preenchimento da caixa obrigatório
        inputCustomizado.focus(); // Joga o foco do cursor diretamente na caixa para digitação
      } else {
        containerCustomizado.style.display = 'none'; // Oculta o campo de texto caso mude para um padrão
        inputCustomizado.removeAttribute('required'); // Remove a obrigatoriedade de preenchimento
        inputCustomizado.value = ''; // Limpa qualquer resíduo digitado para evitar envio incorreto
      }
    });
  });
</script>