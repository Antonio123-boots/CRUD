<div class="profile-shell">
  <div class="profile-card--wide configuration-dashboard">
    
    <div class="config-dashboard-header">
      <h1 class="config-main-title">Configurações Gerais do Evento</h1>
      <p class="config-main-subtitle">
        Controle prazos críticos, limites operacionais por delegação e o catálogo de modalidades oficiais do JIFC.
      </p>
    </div>

    <form action="/admin/configurar/salvar" method="POST" class="modern-config-form">
      
      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Duração Oficial</h2>
            <p class="context-subtitle">Defina o intervalo de realização dos jogos no calendário.</p>
          </div>
        </div>
        
        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Data de Início do Evento</span>
            <input type="date" class="premium-date-input" name="inicio_evento" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_evento) ? configuracoes.inicio_evento : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Data de Término do Evento</span>
            <input type="date" class="premium-date-input" name="fim_evento" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_evento) ? configuracoes.fim_evento : '' %>" required>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Prazos de Inscrições e Processos</h2>
            <p class="context-subtitle">Gerencie as janelas de tempo permitidas para cada etapa do sistema.</p>
          </div>
        </div>
        
        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Inscrição de Modalidades)</span>
            <input type="date" class="premium-date-input" name="inicioInscricoesModalidades" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_inscricao_modalidades) ? configuracoes.inicio_inscricao_modalidades : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Inscrição de Modalidades)</span>
            <input type="date" class="premium-date-input" name="fimInscricoesModalidades" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_inscricao_modalidades) ? configuracoes.fim_inscricao_modalidades : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Inscrição de Atletas)</span>
            <input type="date" class="premium-date-input" name="inicioInscricoesAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_inscricao_atletas) ? configuracoes.inicio_inscricao_atletas : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Inscrição de Atletas)</span>
            <input type="date" class="premium-date-input" name="fimInscricoesAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_inscricao_atletas) ? configuracoes.fim_inscricao_atletas : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Início do Sorteio de Chaves</span>
            <input type="date" class="premium-date-input" name="inicioSorteio" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_sorteio_chaves) ? configuracoes.inicio_sorteio_chaves : '' %>" required>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Restrições Gerais do Campus</h2>
            <p class="context-subtitle">Definição do limite máximo de participantes que um campus pode enviar no total.</p>
          </div>
        </div>
        
        <div class="management-fields-row">
          <label class="premium-input-wrapper" style="width: 100%;">
            <span class="field-label-text">Quantidade Total Máxima da Delegação (Todos os esportes somados)</span>
            <input type="number" class="premium-number-input" name="limite_atletas_total_campus" min="1" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.limite_atletas_total_campus) ? configuracoes.limite_atletas_total_campus : 0 %>" placeholder="Ex: 50 atletas no total" required>
          </label>
        </div>
      </div>

      <div class="config-submit-bar">
        <button type="submit" class="premium-action-btn primary-save-btn">
          <span>Gravar Parâmetros Globais</span>
        </button>
      </div>
    </form>

    <div class="inner-management-card isolated-module">
      <div class="card-context-header">
        <div>
          <h2 class="context-title">Cadastrar Nova Modalidade Esportiva</h2>
          <p class="context-subtitle">Insira novas categorias oficiais configurando o limite específico de atletas exigido por este esporte.</p>
        </div>
      </div>

      <form action="/admin/modalidades/cadastrar" method="POST" class="clean-register-form">
        <div class="dynamic-registration-flow">
          
          <div class="flow-element select-container">
            <span class="field-label-text">Selecione a Modalidade Base</span>
            <select name="modalidade_base" id="seletorModalidade" class="premium-select-field" required>
              <option value="" disabled selected>Escolha um esporte...</option>
              <option value="Atletismo">Atletismo</option>
              <option value="Basquetebol">Basquetebol</option>
              <option value="Futsal">Futsal</option>
              <option value="Handebol">Handebol</option>
              <option value="Tênis de Mesa">Tênis de Mesa</option>
              <option value="Voleibol">Voleibol</option>
              <option value="Vôlei de Praia">Vôlei de Praia</option>
              <option value="Xadrez">Xadrez</option>
              <option value="OUTRO">Outro...</option>
            </select>
          </div>

          <div class="flow-element input-container hidden-input-state" id="containerModalidadeCustomizada">
            <span class="field-label-text custom-alert-text">Nome do Esporte Customizado</span>
            <input type="text" name="modalidade_customizada" id="inputModalidadeCustomizada" class="premium-text-input" placeholder="Ex: Badminton">
          </div>

          <div class="flow-element limit-container">
            <span class="field-label-text">Máximo de Atletas</span>
            <input type="number" name="limite_atletas_por_modalidade" class="premium-number-input" min="1" placeholder="Ex: 12" required>
          </div>

          <div class="flow-element button-container">
            <button type="submit" class="premium-action-btn addition-btn">
              <span>+ Adicionar</span>
            </button>
          </div>

        </div>
      </form>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const seletorModalidade = document.getElementById('seletorModalidade');
    const containerCustomizado = document.getElementById('containerModalidadeCustomizada');
    const inputCustomizado = document.getElementById('inputModalidadeCustomizada');

    seletorModalidade.addEventListener('change', function() {
      if (seletorModalidade.value === 'OUTRO') {
        containerCustomizado.classList.remove('hidden-input-state');
        inputCustomizado.setAttribute('required', 'true');
        inputCustomizado.focus();
      } else {
        containerCustomizado.classList.add('hidden-input-state');
        inputCustomizado.removeAttribute('required');
        inputCustomizado.value = '';
      }
    });
  });
</script>